# Copy to .env and fill in. .env is git-ignored, and the agent is told not to read it.
# Every credential here must be READ-ONLY: that is what enforces "must never" on the card.

# OpsGenie: an API integration key with only "Read" access ticked.
OPSGENIE_API_KEY=
# EU instance: https://api.eu.opsgenie.com
OPSGENIE_API_URL=https://api.opsgenie.com
OPSGENIE_QUERY=status:open

# Logs: set ONE of these. ELASTICSEARCH_URL is queried directly; KIBANA_URL goes through Kibana's console proxy.
ELASTICSEARCH_URL=
KIBANA_URL=
# A read-only role on the log indices. API key, or user + password.
KIBANA_API_KEY=
KIBANA_USER=
KIBANA_PASSWORD=

# Index pattern; {env} is replaced with prd / stg / qa / dev.
KIBANA_INDEX=logs-*
# Field names in your log documents. Check them in Kibana Discover.
FIELD_TIME=@timestamp
FIELD_MESSAGE=message
FIELD_LEVEL=log.level
FIELD_SERVICE=service.name
FIELD_ENV=

# Team knowledge, as config. Defaults shown.
AUTO_CLOSE_ALERTS=Kafka Under Replicated Partitions,Kafka Dead Consumer Group,Kafka Consumer Group Lag
WATCHER_INTERVAL_MINUTES=5
FIX_NOW_COUNT=6

# Replay a recorded case instead of calling the APIs (no credentials needed):
# ALERT_FIXTURES=fixtures/sample
